{
  "manifest_version": 3,
  "name": "Study Subs — dual subtitles for YouTube",
  "version": "1.5.0",
  "description": "Two subtitle tracks at once — original above, translation below — plus sentence-by-sentence shadowing for language practice.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "111",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": ["https://www.youtube.com/*"],
  "action": {
    "default_title": "Where to start",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["injected.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["channels.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/literata.woff2", "fonts/inter.woff2", "fonts/andika.woff2", "fonts/jetbrains-mono.woff2"],
      "matches": ["https://www.youtube.com/*"],
      "use_dynamic_url": true
    }
  ]
}
